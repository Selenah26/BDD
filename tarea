/*Tarea 4*/

/*Tarea 4.1*/
/*Vista con restricción de dominio: Crea una vista llamada v_articulos_gama_baja basada en la tabla articulos que filtre aquellos productos cuyo precio sea inferior o igual a 50.00 euros (precio <= 50.00), incorporando obligatoriamente
la cláusula WITH CHECK OPTION.*/
CREATE VIEW tienda_informatica.v_articulos_gama_baja AS
SELECT *
FROM tienda_informatica.articulos
WHERE precio <= 50.00
WITH CHECK OPTION;

/*Tarea 4.2*/
/*Demostración técnica: Razona y demuestra técnicamente qué sucede si el administrador o un usuario con permisos intenta realizar una inserción de un artículo con un precio de 75.00 euros a través de dicha vista.*/

INSERT INTO tienda_informatica.v_articulos_gama_baja (nombre, precio)
VALUES ('Monitor 24 pulgadas', 75.00);

/* Resultado: ERROR 1369 (HY000): CHECK OPTION failed
   'tienda_informatica.v_articulos_gama_baja' */

/* Contraprueba con un precio válido */
INSERT INTO tienda_informatica.v_articulos_gama_baja (nombre, precio)
VALUES ('Raton USB', 12.50);

/* Resultado: OK, 1 fila insertada */

/*Razonamiento: con WITH CHECK OPTION, MySQL comprueba que cada fila insertada o modificada a través de la vista cumpla el WHERE (precio <= 50.00). 75.00 no lo cumple, así que la operación se cancela y no se escribe nada en la tabla articulos. Afecta también al administrador, porque es una regla de integridad de
la vista y no un permiso.*/


